body:has(#chapters) #main {
  background: transparent !important;
}

body:has(#chapters) #chapters {
  width: 94%;
  max-width: none;
  margin: 0 auto;
  padding: 2.8em 5em;
  box-sizing: border-box;
  background: rgba(25, 30, 53, 0.72) !important;
  border: 1px solid rgba(236, 211, 237, 0.18);
  border-radius: 10px;
  box-shadow: 0 0 30px rgba(8, 11, 28, 0.25), inset 0 0 35px rgba(236, 211, 237, 0.025);
}

body:has(#chapters) .chapter {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

body:has(#chapters) .chapter h3 {
  border-bottom: none !important;
  text-align: center;
  padding-bottom: 1.2em;
  position: relative;
}

body:has(#chapters) .chapter h3::after {
  content: "✦ · ˚ · ✦";
  display: block;
  margin-top: 0.7em;
  font-size: 0.65em;
  font-weight: normal;
  letter-spacing: 0.45em;
  color: rgba(236, 211, 237, 0.42);
}

body:has(#chapters) .chapter .userstuff hr {
  border: 0;
  border-top: 1px solid rgba(236, 211, 237, 0.30);
  height: 0;
  margin: 2em auto;
  max-width: 12em;
  position: relative;
}

body:has(#chapters) .chapter .userstuff hr::after {
  content: "✦";
  display: block;
  position: relative;
  top: -0.65em;
  width: 2em;
  margin: 0 auto;
  text-align: center;
  background: #171c32;
  color: rgba(236, 211, 237, 0.45);
  font-size: 0.75em;
}

body:has(#chapters) #chapters .notes,
